# Google Apps Script Web App URL for form submissions (see google-sheets/README.md)
NEXT_PUBLIC_SHEETS_ENDPOINT=

# Firebase — powers the hidden Director Portal at /director (see firebase/README.md).
# All server-side: none of these reach the browser.
#   Project settings → General → Web API key
FIREBASE_WEB_API_KEY=
#   Project settings → Service accounts → Generate new private key (from the downloaded JSON)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Only for the one-time move from Supabase (scripts/firebase/migrate-from-supabase.mjs).
# Remove both once the move is done.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
