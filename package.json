{
  "name": "rcmsc-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "intro:photos": "node scripts/build-intro-photos.mjs",
    "test": "vitest run",
    "video:studio": "remotion studio",
    "video:render": "remotion render",
    "video:still": "remotion still",
    "video:new": "node scripts/new-video.mjs",
    "video:typecheck": "tsc -p remotion/tsconfig.json",
    "video:upgrade": "remotion upgrade",
    "video:photos": "node scripts/build-video-photos.mjs",
    "video:intro": "npm run video:intro:landscape && npm run video:intro:portrait && npm run video:intro:encode",
    "video:intro:landscape": "remotion render IntroLandscape out/intro/master-landscape.mp4 --codec=h264 --crf=12 --muted",
    "video:intro:portrait": "remotion render IntroPortrait out/intro/master-portrait.mp4 --codec=h264 --crf=12 --muted",
    "video:intro:encode": "node scripts/encode-intro.mjs",
    "video:intro:poster": "remotion still IntroLandscape public/intro-video/poster-landscape.webp --frame=426 --image-format=webp && remotion still IntroPortrait public/intro-video/poster-portrait.webp --frame=426 --image-format=webp"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.0",
    "@remotion/cli": "4.0.533",
    "@remotion/google-fonts": "4.0.533",
    "@remotion/media": "4.0.533",
    "@remotion/motion-blur": "4.0.533",
    "@remotion/noise": "4.0.533",
    "@remotion/paths": "4.0.533",
    "@remotion/sfx": "4.0.533",
    "@remotion/shapes": "4.0.533",
    "@remotion/transitions": "4.0.533",
    "@remotion/zod-types": "4.0.533",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.16.0",
    "next": "16.4.2",
    "ogl": "^1.0.11",
    "postprocessing": "^6.39.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.533",
    "three": "^0.186.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.41",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
